+    monkeypatch.setattr(soprosynth, "resolve_reference_audio", resolve_reference)
+    selection, diagnostics = adapter.resolve(
+        EngineRequest(
+            engine="sopro",
+            target_id="model-alias",
+            language="en-US",
+            options={
+                "voice_source": source,
+                "profile": "wasm-uint8",
