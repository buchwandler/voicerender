+
+    def resolve_reference(*args: Any, **kwargs: Any) -> ResolvedReferenceAudio:
+        resolve_calls.append((args, kwargs))
+        return ResolvedReferenceAudio(
+            kind="managed_reference",
+            path=Path("/cache/voice-a.wav"),
+            sha256=source["sha256"],
+            resolver="voicefolio",
+            ref=source["value"],
