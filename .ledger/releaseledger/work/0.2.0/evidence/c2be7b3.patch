+                "temperature": 0.65,
+                "top_p": 0.8,
+                "top_k": 12,
+                "steps": 9,
+                "max_seconds": 12,
+                "min_seconds": 1,
+                "random_seed": 17,
+                "text_chunk_size": 180,
+                "output_mode": "raw",
+                "voice_level": "calibrated",
+                "voice_level_gain_db": 1.5,
+                "providers": ("cpu",),
