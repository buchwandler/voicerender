+
+
+def test_synthesize_does_not_flatten_malformed_channels() -> None:
+    audio = np.array([[0.0, 1.1], [0.2, 0.3]], dtype=np.float32)
+    voice = _FakeVoice(None, _synthesis_result(audio))
+
