+    data = _synthetic_plan()
+    data["flow"][0]["segment"][0]["replacement"] = {
+        "span": [[0, 4]],
+        "source": ["Flow"],
+        "kind": [[0, "structured"]],
+        "rule": [[0, "test-rule"]],
+    }
+    annotated = parse_utterplan_v5(data, file_sha256="a" * 64)
+
+    assert annotated.plan_id == plain.plan_id
+    assert annotated.flows[0].flow_hash == plain.flows[0].flow_hash
