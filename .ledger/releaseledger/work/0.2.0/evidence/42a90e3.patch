+"""Exact execution of a preflight-approved shared RenderPlan."""
+
+from __future__ import annotations
+
+import json
+import os
+import shutil
+from collections.abc import Iterator
+from contextlib import ExitStack, contextmanager
+from dataclasses import asdict, dataclass
+from pathlib import Path
+from typing import Any
+
+from renderplan import (
+    PreflightCheck,
+    PreflightReport,
+    Producer,
+    RenderManifest,
+    RenderPlan,
+    ReplanRequest,
+    SpeechArtifact,
+    SpeechItem,
+    load_plan,
+    load_preflight,
+    save_manifest,
+    save_preflight,
+)
+
+from .engines.base import EngineSelection, EngineSession, SpeechRequest
+from .engines.registry import get_adapter, open_session
+from .errors import ArtifactError, PlanError
+from .preflight import _session_compatibility_key
+from .renderplan_input import (
+    MeasurementOutcome,
+    PreflightDisposition,
+    classify_measurement,
+    engine_selection_from_binding,
+    speech_request_from_renderplan,
+)
+from .storage import atomic_json, atomic_wav, digest, verified_wav, wav_info
+
+RENDER_MANIFEST_FILENAME = "render-manifest.toml"
+_CACHE_SCHEMA = "voicerender.renderplan-cache.v1"
+
+
+@dataclass(frozen=True, slots=True)
+class RenderPlanResult:
+    manifest: RenderManifest
+    manifest_path: Path
+    rendered_count: int
+    reused_count: int
+    error: str | None = None
+    fresh_preflight: PreflightReport | None = None
+
+    @property
+    def failed(self) -> bool:
+        return self.error is not None or not self.manifest.complete
+
+
+@dataclass(frozen=True, slots=True)
+class _PreparedSpeech:
+    item: SpeechItem
+    request: SpeechRequest
+    selection: EngineSelection
+    segment_id: str
+    cache_key: str
+    session_key: str
+
+
+@dataclass(frozen=True, slots=True)
+class _OpenFailure:
+    error: Exception
+
+
+@dataclass(frozen=True, slots=True)
+class _RenderFailure:
+    message: str
+    fresh_preflight: PreflightReport | None = None
+
+
+def render_renderplan(
+    plan: RenderPlan | str | Path,
+    *,
+    preflight: PreflightReport | str | Path,
+    output_dir: str | Path,
+    cache_dir: str | Path | None = None,
+    force: bool = False,
+    recheck_report_path: str | Path | None = None,
+) -> RenderPlanResult:
+    """Render one WAV per SpeechItem, returning a complete or valid partial manifest."""
+    parsed_plan = load_plan(plan) if isinstance(plan, (str, Path)) else plan
+    if not isinstance(parsed_plan, RenderPlan):
+        raise PlanError("render input must be a RenderPlan")
+    report = (
+        load_preflight(preflight) if isinstance(preflight, (str, Path)) else preflight
+    )
+    if not isinstance(report, PreflightReport):
+        raise PlanError("render requires a shared RenderPlan preflight report")
+    if report.status != "ok":
+        raise PlanError(
+            f"RenderPlan preflight status must be 'ok', got {report.status!r}"
+        )
+    try:
+        report.validate_against(parsed_plan)
+    except ValueError as exc:
+        raise PlanError(
+            f"RenderPlan preflight report does not match the plan: {exc}"
+        ) from exc
+    checked = {
+        (check.segment_number, check.segment_id): check for check in report.checks
+    }
+    for item in parsed_plan.speech:
+        if not item.preflight_required:
+            continue
+        key = (item.number, item.segment_id or item.computed_id())
+        check = checked.get(key)
+        if check is None or check.status != "ok":
+            raise PlanError(
+                f"Speech occurrence {key} does not have a matching OK preflight check"
+            )
+
+    prepared = tuple(_prepare_speech(item) for item in parsed_plan.speech)
+    out = Path(output_dir).expanduser().resolve()
+    cache = (
+        Path(cache_dir).expanduser().resolve()
+        if cache_dir is not None
+        else out.parent / ".voicerender-cache"
+    )
+    if cache == out or cache.is_relative_to(out) or out.is_relative_to(cache):
+        raise ArtifactError("cache_dir must be outside the RenderPlan output directory")
+    manifest_path = out / RENDER_MANIFEST_FILENAME
+    report_id = parsed_plan.plan_id or parsed_plan.computed_id()
+    producer = Producer(name="voicerender", version=_voicerender_version())
+
+    artifacts: list[SpeechArtifact] = []
+    rendered = reused = 0
+    failure: _RenderFailure | None = None
+    with _exclusive_render(out):
+        cache.mkdir(parents=True, exist_ok=True)
+        _persist_manifest(
+            parsed_plan,
+            manifest_path,
+            report_id,
+            artifacts,
+            complete=False,
+            producer=producer,
+        )
+        with ExitStack() as opened:
+            sessions: dict[str, EngineSession | _OpenFailure] = {}
+            for current in prepared:
+                item = current.item
+                target = out / item.wav
+                try:
+                    cached = None if force else _read_cache(cache, current.cache_key)
+                    if cached is not None:
+                        source, info = cached
+                        _copy_verified(source, target, info)
+                        reused += 1
+                    else:
+                        session = sessions.get(current.session_key)
+                        if session is None:
+                            try:
+                                session = opened.enter_context(
+                                    open_session(current.selection)
+                                )
+                            except Exception as exc:  # noqa: BLE001 - Renderer setup must become a partial-render result.
+                                session = _OpenFailure(exc)
+                            sessions[current.session_key] = session
+                        if isinstance(session, _OpenFailure):
+                            failure = _RenderFailure(
+                                f"Cannot open renderer session: {session.error}",
+                                fresh_preflight=(
+                                    _rejected_report(
+                                        parsed_plan,
+                                        item,
+                                        current.segment_id,
+                                        session.error,
+                                    )
+                                    if item.preflight_required
+                                    else None
+                                ),
+                            )
+                            break
+
+                        try:
+                            measured = session.measure(current.request)
+                        except Exception as exc:  # noqa: BLE001 - Capacity/runtime errors are centrally classified.
+                            outcome = classify_measurement(exc)
+                        else:
+                            outcome = classify_measurement(measured)
+                        if outcome.disposition is not PreflightDisposition.OK:
+                            fresh = (
+                                _failure_report(
+                                    parsed_plan,
+                                    item,
+                                    current.segment_id,
+                                    outcome,
+                                )
+                                if item.preflight_required
+                                else None
+                            )
+                            if recheck_report_path is not None and fresh is not None:
+                                save_preflight(fresh, recheck_report_path)
+                            failure = _RenderFailure(
+                                outcome.error
+                                or "Immediate renderer remeasurement did not return an exact fit",
+                                fresh_preflight=fresh,
+                            )
+                            break
+
+                        rendered_speech = session.synthesize(current.request)
+                        if rendered_speech.id != current.request.id:
+                            raise ArtifactError(
+                                "Renderer returned an artifact for a different speech request"
+                            )
+                        info = atomic_wav(
+                            cache / f"{current.cache_key}.wav",
+                            rendered_speech.audio,
+                            rendered_speech.sample_rate,
+                        )
+                        atomic_json(
+                            cache / f"{current.cache_key}.json",
+                            {
+                                "schema": _CACHE_SCHEMA,
+                                "key": current.cache_key,
+                                "wav": info,
+                            },
+                        )
+                        if not verified_wav(cache / f"{current.cache_key}.wav", info):
+                            raise ArtifactError(
+                                "New cache WAV failed integrity validation"
+                            )
+                        _copy_verified(cache / f"{current.cache_key}.wav", target, info)
+                        rendered += 1
+
+                    final_info = wav_info(target)
+                    if not verified_wav(target, final_info):
+                        raise ArtifactError(
+                            f"Materialized WAV failed integrity validation: {target}"
+                        )
+                    artifacts.append(
+                        SpeechArtifact(
+                            segment_number=item.number,
+                            segment_id=current.segment_id,
+                            wav=item.wav,
+                            sha256=f"sha256:{final_info['sha256']}",
+                            frames=int(final_info["frames"]),
+                            sample_rate=int(final_info["sample_rate"]),
+                            channels=int(final_info["channels"]),
+                        )
+                    )
+                    _persist_manifest(
+                        parsed_plan,
+                        manifest_path,
+                        report_id,
+                        artifacts,
+                        complete=False,
+                        producer=producer,
+                    )
+                except Exception as exc:  # noqa: BLE001 - Artifact and backend failures persist a valid partial manifest.
+                    failure = _RenderFailure(str(exc) or "Render failed")
+                    break
+
+        complete = failure is None and len(artifacts) == len(parsed_plan.speech)
+        manifest = _persist_manifest(
+            parsed_plan,
+            manifest_path,
+            report_id,
+            artifacts,
+            complete=complete,
+            producer=producer,
+        )
+    return RenderPlanResult(
+        manifest=manifest,
+        manifest_path=manifest_path,
+        rendered_count=rendered,
+        reused_count=reused,
+        error=failure.message if failure is not None else None,
+        fresh_preflight=failure.fresh_preflight if failure is not None else None,
+    )
+
+
+def _prepare_speech(item: SpeechItem) -> _PreparedSpeech:
+    try:
+        request = speech_request_from_renderplan(item)
+        selection = engine_selection_from_binding(item.binding, language=item.language)
+        adapter = get_adapter(selection.engine)
+        session_key = _session_compatibility_key(adapter, selection)
+        identity = {
+            "schema": _CACHE_SCHEMA,
+            "segment_id": item.segment_id or item.computed_id(),
+            "engine": adapter.id,
+            "engine_version": adapter.version(),
+            "api_probe": asdict(adapter.probe_api()),
+            "engine_identity": dict(adapter.canonical_synthesis_identity(selection)),
+            "language": selection.language,
+            "voice": selection.voice,
+            "speaker": selection.speaker,
+            "options": dict(selection.options),
+            "offline": selection.offline,
+        }
+        cache_key = digest(identity)
+    except Exception as exc:
+        raise PlanError(
+            f"Cannot prepare speech occurrence {item.number} before rendering: {exc}"
+        ) from exc
+    return _PreparedSpeech(
+        item=item,
+        request=request,
+        selection=selection,
+        segment_id=item.segment_id or item.computed_id(),
+        cache_key=cache_key,
+        session_key=session_key,
+    )
+
+
+def _read_cache(cache_dir: Path, key: str) -> tuple[Path, dict[str, Any]] | None:
+    wav = cache_dir / f"{key}.wav"
+    sidecar = cache_dir / f"{key}.json"
+    try:
+        data = json.loads(sidecar.read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        return None
+    if (
+        not isinstance(data, dict)
+        or data.get("schema") != _CACHE_SCHEMA
+        or data.get("key") != key
+    ):
+        return None
+    info = data.get("wav")
+    if not isinstance(info, dict) or not verified_wav(wav, info):
+        return None
+    return wav, info
+
+
+def _copy_verified(source: Path, target: Path, info: dict[str, Any]) -> None:
+    target.parent.mkdir(parents=True, exist_ok=True)
+    temporary = target.with_name(f".{target.name}.tmp-{os.getpid()}")
+    try:
+        shutil.copyfile(source, temporary)
+        if not verified_wav(temporary, info):
+            raise ArtifactError(f"WAV copy failed integrity validation: {source}")
+        os.replace(temporary, target)
+    finally:
+        temporary.unlink(missing_ok=True)
+
+
+def _persist_manifest(
+    plan: RenderPlan,
+    path: Path,
+    plan_id: str,
+    artifacts: list[SpeechArtifact],
+    *,
+    complete: bool,
+    producer: Producer,
+) -> RenderManifest:
+    manifest = RenderManifest(
+        render_plan_id=plan_id,
+        speech=tuple(artifacts),
+        complete=complete,
+        producer=producer,
+    ).with_identity()
+    manifest.validate_against(plan)
+    save_manifest(manifest, path)
+    return manifest
+
+
+def _failure_report(
+    plan: RenderPlan,
+    item: SpeechItem,
+    segment_id: str,
+    outcome: MeasurementOutcome,
+) -> PreflightReport:
+    measurement = outcome.measurement
+    if outcome.disposition is PreflightDisposition.TOO_LONG:
+        status = "too_long"
+        report_status = "replan"
+    else:
+        status = "error"
+        report_status = "reject"
+    check = PreflightCheck(
+        segment_number=item.number,
+        segment_id=segment_id,
+        status=status,
+        metric=measurement.unit if measurement is not None else "unknown",
+        measured=measurement.amount if measurement is not None else None,
+        maximum=measurement.maximum if measurement is not None else None,
+        source=(
+            measurement.source
+            if measurement is not None
+            and isinstance(measurement.source, str)
+            and measurement.source.strip()
+            else "voicerender.render.remeasurement"
+        ),
+        detail=outcome.error,
+    )
+    requests: tuple[ReplanRequest, ...] = ()
+    if report_status == "replan":
+        requests = (
+            ReplanRequest(
+                segment_number=item.number,
+                segment_id=segment_id,
+                source=item.source,
+                current_level=item.planning_level,
+                action="split",
+                reason="capacity",
+                metric=check.metric,
+                measured=check.measured,
+                maximum=check.maximum,
+            ),
+        )
+    report = PreflightReport(
+        render_plan_id=plan.plan_id or plan.computed_id(),
+        source_plan_id=plan.source_plan_id,
+        render_profile_id=plan.render_profile_id,
+        status=report_status,
+        checks=(check,),
+        replan=requests,
+        producer=Producer(name="voicerender", version=_voicerender_version()),
+    ).with_identity()
+    report.validate_against(plan)
+    return report
+
+
+def _rejected_report(
+    plan: RenderPlan,
+    item: SpeechItem,
+    segment_id: str,
+    error: Exception,
+) -> PreflightReport:
+    raw_code = getattr(error, "code", None)
+    source = (
+        raw_code
+        if isinstance(raw_code, str) and raw_code.strip()
+        else "voicerender.render.session"
+    )
+    check = PreflightCheck(
+        segment_number=item.number,
+        segment_id=segment_id,
+        status="error",
+        metric="unknown",
+        measured=None,
+        maximum=None,
+        source=source,
+        detail=str(error) or "Renderer session could not be opened",
+    )
+    report = PreflightReport(
+        render_plan_id=plan.plan_id or plan.computed_id(),
+        source_plan_id=plan.source_plan_id,
+        render_profile_id=plan.render_profile_id,
+        status="reject",
+        checks=(check,),
+        producer=Producer(name="voicerender", version=_voicerender_version()),
+    ).with_identity()
+    report.validate_against(plan)
+    return report
+
+
+def _voicerender_version() -> str:
+    from importlib.metadata import PackageNotFoundError, version
+
+    try:
+        return version("voicerender")
+    except PackageNotFoundError:
+        return "0+unknown"
+
+
+@contextmanager
+def _exclusive_render(output_dir: Path) -> Iterator[None]:
+    output_dir.mkdir(parents=True, exist_ok=True)
+    lock = output_dir / ".voicerender.lock"
+    try:
+        descriptor = os.open(lock, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
+    except FileExistsError as exc:
+        raise ArtifactError(f"Render directory is locked: {output_dir}") from exc
+    try:
+        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
+            stream.write(str(os.getpid()))
+        yield
+    finally:
+        lock.unlink(missing_ok=True)
+
+
+__all__ = [
+    "RENDER_MANIFEST_FILENAME",
+    "RenderPlanResult",
+    "render_renderplan",
+]
diff --git a/voicerender/renderprofile.py b/voicerender/renderprofile.py
new file mode 100644
index 0000000..92d04b3
--- /dev/null
+++ b/voicerender/renderprofile.py
@@ -0,0 +1,289 @@
+"""VoiceRender ownership and lifecycle helpers for shared RenderProfiles."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from dataclasses import replace
+from pathlib import Path
+from typing import Any, cast
+
+from renderplan import (
+    PausePolicy,
+    PlanningPolicy,
+    RenderProfile,
+    RoleProfile,
+    RoleRequirements,
+    load_profile,
+    save_profile,
+)
+
+from .engines.base import EngineSelection, RenderProfileFragment
+from .engines.profiles import reject_reference_binding
+from .engines.registry import get_adapter, normalize_engine_id, resolve_voice
+from .engines.selection import EngineRequest
+from .errors import ProfileError
+
+_DEFAULT_PAUSES = PausePolicy(
+    mode="manual",
+    durations_ms={"clause": 180, "sentence": 500, "paragraph": 800},
+)
+
+
+def create_render_profile(
+    *,
+    engine: str,
+    target_id: str,
+    language: str,
+    role: str = "narrator",
+    voice: str | None = None,
+    speaker: str | int | None = None,
+    options: Mapping[str, Any] | None = None,
+    offline: bool = False,
+    refresh: bool = False,
+) -> RenderProfile:
+    """Discover a binding and seed a user-owned shared RenderProfile."""
+    if not role.strip():
+        raise ProfileError("Profile role name must not be empty")
+    if not language.strip():
+        raise ProfileError("Profile language must not be empty")
+    request = EngineRequest(
+        engine=engine,
+        target_id=target_id,
+        language=language,
+        voice=voice,
+        speaker=speaker,
+        options=dict(options or {}),
+        offline=offline,
+        refresh=refresh,
+    )
+    _, fragment = _resolve_fragment(request)
+    role_profile = RoleProfile(
+        language=language,
+        binding=dict(fragment.binding),
+        requirements=RoleRequirements(
+            token_fields=fragment.token_fields,
+            frontend=fragment.frontend,
+            pronunciation=fragment.pronunciation,
+        ),
+        planner_capacity=fragment.planner_capacity,
+        renderer_capacity=fragment.renderer_capacity,
+    )
+    return RenderProfile(
+        roles={role: role_profile},
+        default_role=role,
+        planning=PlanningPolicy(
+            split="sentence", capacity_fallback=("clause", "token")
+        ),
+        pauses=_DEFAULT_PAUSES,
+    ).with_identity()
+
+
+def load_render_profile(profile: str | Path | RenderProfile) -> RenderProfile:
+    """Load a shared RenderProfile, preserving RenderPlan's strict codec checks."""
+    if isinstance(profile, RenderProfile):
+        return profile
+    try:
+        return load_profile(profile)
+    except Exception as exc:
+        raise ProfileError(f"Cannot load RenderProfile {profile}: {exc}") from exc
+
+
+def save_render_profile(profile: RenderProfile, path: str | Path) -> Path:
+    """Persist a shared RenderProfile using the RenderPlan codec."""
+    try:
+        return cast(Path, save_profile(profile, path))
+    except Exception as exc:
+        raise ProfileError(f"Cannot write RenderProfile {path}: {exc}") from exc
+
+
+def validate_render_profile(
+    profile: str | Path | RenderProfile,
+) -> RenderProfile:
+    """Check each profile binding against the installed engine adapter/API."""
+    loaded = load_render_profile(profile)
+    for role_name, role in loaded.roles.items():
+        binding = role.binding
+        reject_reference_binding(binding)
+        renderer = _required_string(
+            binding.get("renderer"), f"roles.{role_name}.binding.renderer"
+        )
+        target_id = _required_string(
+            binding.get("target_id"), f"roles.{role_name}.binding.target_id"
+        )
+        options = binding.get("options", {})
+        if not isinstance(options, Mapping):
+            raise ProfileError(f"Role {role_name!r} binding options must be a table")
+        model_revision = binding.get("model_revision")
+        if model_revision is not None and (
+            not isinstance(model_revision, str) or not model_revision
+        ):
+            raise ProfileError(
+                f"Role {role_name!r} model_revision must be a non-empty string"
+            )
+        selection, fragment = _resolve_fragment(
+            EngineRequest(
+                engine=renderer,
+                target_id=target_id,
+                language=role.language,
+                voice=_optional_string(binding.get("voice"), "voice"),
+                speaker=binding.get("speaker"),
+                options=dict(options),
+            )
+        )
+        if selection.target_id != target_id:
+            raise ProfileError(
+                f"Role {role_name!r} resolves to unexpected target {selection.target_id!r}"
+            )
+        expected_requirements = RoleRequirements(
+            token_fields=fragment.token_fields,
+            frontend=fragment.frontend,
+            pronunciation=fragment.pronunciation,
+        )
+        if (
+            role.requirements != expected_requirements
+            or role.renderer_capacity != fragment.renderer_capacity
+            or role.planner_capacity != fragment.planner_capacity
+        ):
+            raise ProfileError(
+                f"Role {role_name!r} engine-derived requirements/capacity are stale; "
+                "write and review a refreshed proposal"
+            )
+        proposed_metadata = fragment.binding.get("renderer_metadata", {})
+        current_metadata = binding.get("renderer_metadata", {})
+        if not isinstance(proposed_metadata, Mapping):
+            proposed_metadata = {}
+        if not isinstance(current_metadata, Mapping):
+            current_metadata = {}
+        if dict(current_metadata) != dict(proposed_metadata):
+            raise ProfileError(
+                f"Role {role_name!r} target metadata is stale; "
+                "write and review a refreshed proposal"
+            )
+    return loaded
+
+
+def refresh_render_profile(
+    profile: str | Path | RenderProfile,
+) -> RenderProfile:
+    """Return a refreshed proposal without changing user-owned profile policy."""
+    original = load_render_profile(profile)
+    refreshed_roles: dict[str, RoleProfile] = {}
+    for role_name, role in original.roles.items():
+        binding = dict(role.binding)
+        reject_reference_binding(binding)
+        renderer = _required_string(
+            binding.get("renderer"), f"roles.{role_name}.renderer"
+        )
+        target_id = _required_string(
+            binding.get("target_id"), f"roles.{role_name}.target_id"
+        )
+        options = binding.get("options", {})
+        if not isinstance(options, Mapping):
+            raise ProfileError(f"Role {role_name!r} binding options must be a table")
+        _, fragment = _resolve_fragment(
+            EngineRequest(
+                engine=renderer,
+                target_id=target_id,
+                language=role.language,
+                voice=_optional_string(binding.get("voice"), "voice"),
+                speaker=binding.get("speaker"),
+                options=dict(options),
+                refresh=True,
+            )
+        )
+        new_binding = dict(binding)
+        new_metadata = fragment.binding.get("renderer_metadata")
+        if isinstance(new_metadata, Mapping):
+            new_binding["renderer_metadata"] = dict(new_metadata)
+        if binding.get("model_revision") is None and fragment.binding.get(
+            "model_revision"
+        ):
+            new_binding["model_revision"] = fragment.binding["model_revision"]
+        refreshed_roles[role_name] = RoleProfile(
+            language=role.language,
+            binding=new_binding,
+            requirements=RoleRequirements(
+                token_fields=fragment.token_fields,
+                frontend=fragment.frontend,
+                pronunciation=fragment.pronunciation,
+            ),
+            planner_capacity=fragment.planner_capacity,
+            renderer_capacity=fragment.renderer_capacity,
+        )
+    return replace(original, roles=refreshed_roles, profile_id=None).with_identity()
+
+
+def _resolve_fragment(
+    request: EngineRequest,
+) -> tuple[EngineSelection, RenderProfileFragment]:
+    if not request.engine:
+        raise ProfileError("A renderer engine is required")
+    adapter = get_adapter(request.engine)
+    probe = adapter.probe_api()
+    if not probe.compatible:
+        raise ProfileError(f"Engine {adapter.id!r} API is incompatible: {probe.status}")
+    selection, diagnostics = resolve_voice(request)
+    errors = [
+        item for item in diagnostics if getattr(item, "severity", None) == "error"
+    ]
+    if errors:
+        details = "; ".join(f"{item.code}: {item.message}" for item in errors)
+        raise ProfileError(f"Engine binding is invalid: {details}")
+    if normalize_engine_id(selection.engine) != normalize_engine_id(adapter.id):
+        raise ProfileError("Engine adapter resolved an inconsistent renderer binding")
+    selection = _with_target_metadata(adapter, selection)
+    try:
+        fragment = adapter.renderprofile_fragment(selection)
+    except (ProfileError, ValueError) as exc:
+        raise ProfileError(
+            f"Cannot create engine RenderProfile fragment: {exc}"
+        ) from exc
+    if not isinstance(fragment, RenderProfileFragment):
+        raise ProfileError(
+            f"Engine {adapter.id!r} returned an invalid RenderProfile fragment"
+        )
+    reject_reference_binding(fragment.binding)
+    if fragment.binding.get("renderer") != adapter.id:
+        raise ProfileError("RenderProfile fragment renderer does not match its adapter")
+    if fragment.binding.get("target_id") != selection.target_id:
+        raise ProfileError(
+            "RenderProfile fragment target_id does not match its selection"
+        )
+    return selection, fragment
+
+
+def _with_target_metadata(adapter: Any, selection: EngineSelection) -> EngineSelection:
+    metadata_reader = getattr(adapter, "target_metadata", None)
+    if not callable(metadata_reader):
+        return selection
+    try:
+        target_metadata = metadata_reader(selection)
+    except Exception as exc:
+        raise ProfileError(f"Cannot discover target metadata: {exc}") from exc
+    if not isinstance(target_metadata, Mapping):
+        return selection
+    return replace(
+        selection,
+        metadata={**dict(selection.metadata), **dict(target_metadata)},
+    )
+
+
+def _required_string(value: Any, field_name: str) -> str:
+    if not isinstance(value, str) or not value.strip():
+        raise ProfileError(f"{field_name} must be a non-empty string")
+    return value
+
+
+def _optional_string(value: Any, field_name: str) -> str | None:
+    if value is None:
+        return None
+    return _required_string(value, field_name)
+
+
+__all__ = [
+    "create_render_profile",
+    "load_render_profile",
+    "refresh_render_profile",
+    "save_render_profile",
+    "validate_render_profile",
+]
