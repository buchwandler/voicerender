-    output: dict[str, Any] = {}
-    converters = {
-        "rate": ("tempo", "factor", _ssmd_rate_factor),
-        "pitch": ("pitch_shift", "semitones", _ssmd_pitch_semitones),
-        "volume": ("gain", "db", _ssmd_volume_db),
