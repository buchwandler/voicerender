diff --git a/voicerender/models_api.py b/voicerender/models_api.py
new file mode 100644
index 0000000..324be2e
--- /dev/null
+++ b/voicerender/models_api.py
@@ -0,0 +1,289 @@
+"""Public model management API for VoiceRender engines."""
+
+from __future__ import annotations
+
+from dataclasses import asdict
+from pathlib import Path
+from typing import Any
+
+from .engines.assets import (
+    ModelArtifact,
+    ModelInstallRequest,
+    ModelInstallResult,
+    ModelManagementCapabilities,
+    ModelRemoveRequest,
+    ModelRemoveResult,
+    ModelVerifyResult,
+)
+from .engines.registry import discover_targets, get_asset_manager, normalize_engine_id
+from .errors import ProfileError
+
+
+def _unsupported(engine: str, operation: str, target_id: str) -> str:
+    return (
+        f"Engine {engine!r} does not support model {operation} for target {target_id!r}"
+    )
+
+
+def _capabilities(
+    engine: str,
+) -> tuple[Any, ModelManagementCapabilities] | tuple[None, ModelManagementCapabilities]:
+    manager = get_asset_manager(engine)
+    if manager is None:
+        return None, ModelManagementCapabilities()
+    capabilities = manager.capabilities()
+    return manager, capabilities
+
+
+def _from_target(target: Any) -> ModelArtifact:
+    installed = bool(target.runtime_available)
+    metadata = dict(target.metadata)
+    source = metadata.get("source")
+    revision = metadata.get("revision", metadata.get("source_revision"))
+    path = metadata.get("path")
+    return ModelArtifact(
+        engine=target.engine,
+        target_id=target.id,
+        display_name=target.display_name,
+        installed=installed,
+        status=target.status,
+        languages=tuple(target.languages),
+        qualities=tuple(target.qualities),
+        installed_qualities=tuple(target.qualities) if installed else (),
+        source=str(source) if source is not None else None,
+        revision=str(revision) if revision is not None else None,
+        path=Path(path) if isinstance(path, (str, Path)) else None,
+        metadata=metadata,
+    )
+
+
+def list_models(
+    engine: str,
+    *,
+    language: str | None = None,
+    installed: bool | None = None,
+    offline: bool = False,
+    refresh: bool = False,
+) -> tuple[ModelArtifact, ...]:
+    """List model artifacts without opening a synthesis runtime."""
+    engine_id = normalize_engine_id(engine)
+    manager, capabilities = _capabilities(engine_id)
+    if manager is not None and capabilities.can_list:
+        models = tuple(
+            manager.list_models(language=language, offline=offline, refresh=refresh)
+        )
+    else:
+        models = tuple(
+            _from_target(target)
+            for target in discover_targets(
+                engine_id, language=language, offline=offline, refresh=refresh
+            )
+        )
+    selected = (
+        model for model in models if installed is None or model.installed is installed
+    )
+    return tuple(sorted(selected, key=lambda model: (model.engine, model.target_id)))
+
+
+def model_status(
+    engine: str, target_id: str, *, quality: str | None = None
+) -> ModelArtifact:
+    """Inspect one target using its manager or side-effect-free target discovery."""
+    engine_id = normalize_engine_id(engine)
+    if not target_id.strip():
+        raise ProfileError("A model target identifier is required")
+    manager, capabilities = _capabilities(engine_id)
+    if manager is not None and capabilities.can_list:
+        model = manager.inspect_model(target_id, quality=quality)
+        if model.engine != engine_id or model.target_id != target_id:
+            raise ProfileError(
+                f"Engine {engine_id!r} returned a mismatched model artifact"
+            )
+        return model
+    for model in list_models(engine_id):
+        if model.target_id == target_id:
+            if quality is not None and quality not in model.qualities:
+                raise ProfileError(
+                    f"Engine {engine_id!r} target {target_id!r} does not provide quality {quality!r}"
+                )
+            return model
+    raise ProfileError(f"Engine {engine_id!r} has no model target {target_id!r}")
+
+
+def install_model(request: ModelInstallRequest) -> ModelInstallResult:
+    """Install a model through the engine's optional public asset manager."""
+    engine_id = normalize_engine_id(request.engine)
+    manager, capabilities = _capabilities(engine_id)
+    if manager is None or not capabilities.can_install:
+        return ModelInstallResult(
+            engine_id,
+            request.target_id,
+            "unsupported",
+            False,
+            (_unsupported(engine_id, "install", request.target_id),),
+        )
+    if request.quality is not None and not capabilities.supports_quality:
+        return ModelInstallResult(
+            engine_id,
+            request.target_id,
+            "unsupported",
+            False,
+            (
+                f"Engine {engine_id!r} does not support quality selection for model install",
+            ),
+        )
+    if request.source is not None and not capabilities.supports_source:
+        return ModelInstallResult(
+            engine_id,
+            request.target_id,
+            "unsupported",
+            False,
+            (
+                f"Engine {engine_id!r} does not support source selection for model install",
+            ),
+        )
+    normalized = ModelInstallRequest(
+        engine_id,
+        request.target_id,
+        request.quality,
+        request.source,
+        request.cache_dir,
+        request.force,
+    )
+    try:
+        return manager.install_model(normalized)
+    except Exception as exc:  # noqa: BLE001 - Backend failures become stable results.
+        return ModelInstallResult(
+            engine_id,
+            request.target_id,
+            "failed",
+            False,
+            (f"Engine {engine_id!r} model install failed: {exc}",),
+        )
+
+
+def remove_model(request: ModelRemoveRequest) -> ModelRemoveResult:
+    """Remove a model through the engine's optional public asset manager."""
+    engine_id = normalize_engine_id(request.engine)
+    manager, capabilities = _capabilities(engine_id)
+    if manager is None or not capabilities.can_remove:
+        return ModelRemoveResult(
+            engine_id,
+            request.target_id,
+            "unsupported",
+            False,
+            (_unsupported(engine_id, "remove", request.target_id),),
+        )
+    if request.quality is not None and not capabilities.supports_quality:
+        return ModelRemoveResult(
+            engine_id,
+            request.target_id,
+            "unsupported",
+            False,
+            (
+                f"Engine {engine_id!r} does not support quality selection for model removal",
+            ),
+        )
+    try:
+        return manager.remove_model(
+            ModelRemoveRequest(
+                engine_id, request.target_id, request.quality, request.cache_dir
+            )
+        )
+    except Exception as exc:  # noqa: BLE001 - Backend failures become stable results.
+        return ModelRemoveResult(
+            engine_id,
+            request.target_id,
+            "failed",
+            False,
+            (f"Engine {engine_id!r} model remove failed: {exc}",),
+        )
+
+
+def verify_model(
+    engine: str,
+    target_id: str,
+    *,
+    quality: str | None = None,
+    cache_dir: Path | None = None,
+) -> ModelVerifyResult:
+    """Verify an installed model through the engine's optional public API."""
+    engine_id = normalize_engine_id(engine)
+    manager, capabilities = _capabilities(engine_id)
+    if manager is None or not capabilities.can_verify:
+        return ModelVerifyResult(
+            engine_id,
+            target_id,
+            "unsupported",
+            False,
+            (_unsupported(engine_id, "verify", target_id),),
+        )
+    if quality is not None and not capabilities.supports_quality:
+        return ModelVerifyResult(
+            engine_id,
+            target_id,
+            "unsupported",
+            False,
+            (
+                f"Engine {engine_id!r} does not support quality selection for model verify",
+            ),
+        )
+    try:
+        return manager.verify_model(target_id, quality=quality, cache_dir=cache_dir)
+    except Exception as exc:  # noqa: BLE001 - Backend failures become stable results.
+        return ModelVerifyResult(
+            engine_id,
+            target_id,
+            "failed",
+            False,
+            (f"Engine {engine_id!r} model verify failed: {exc}",),
+        )
+
+
+def model_artifact_to_dict(model: ModelArtifact) -> dict[str, Any]:
+    """Return the stable JSON representation of a model artifact."""
+    value = asdict(model)
+    value["path"] = str(model.path) if model.path is not None else None
+    value["languages"] = list(model.languages)
+    value["qualities"] = list(model.qualities)
+    value["installed_qualities"] = list(model.installed_qualities)
+    value["metadata"] = dict(model.metadata)
+    return value
+
+
+def model_result_to_dict(
+    result: ModelInstallResult | ModelRemoveResult | ModelVerifyResult,
+) -> dict[str, Any]:
+    """Return a stable JSON representation shared by model operations."""
+    value: dict[str, Any] = {
+        "engine": result.engine,
+        "target_id": result.target_id,
+        "status": result.status,
+        "diagnostics": list(result.diagnostics),
+    }
+    if isinstance(result, ModelVerifyResult):
+        value["verified"] = result.verified
+    else:
+        value["changed"] = result.changed
+    value["artifact"] = (
+        model_artifact_to_dict(result.artifact) if result.artifact is not None else None
+    )
+    return value
+
+
+__all__ = [
+    "ModelArtifact",
+    "ModelInstallRequest",
+    "ModelInstallResult",
+    "ModelManagementCapabilities",
+    "ModelRemoveRequest",
+    "ModelRemoveResult",
+    "ModelVerifyResult",
+    "install_model",
+    "list_models",
+    "model_artifact_to_dict",
+    "model_result_to_dict",
+    "model_status",
+    "remove_model",
+    "verify_model",
+]
diff --git a/voicerender/profile_roles.py b/voicerender/profile_roles.py
new file mode 100644
index 0000000..c119d8e
--- /dev/null
+++ b/voicerender/profile_roles.py
@@ -0,0 +1,122 @@
+"""Public APIs for inspecting and mutating shared RenderProfile roles."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from dataclasses import replace
+from pathlib import Path
+from typing import Any
+
+from renderplan import RenderProfile, RoleProfile
+
+from .errors import ProfileError
+from .renderprofile import create_render_profile, load_render_profile
+
+
+def list_profile_roles(
+    profile: str | Path | RenderProfile,
+) -> Mapping[str, RoleProfile]:
+    """Return the profile's role bindings without changing their semantics."""
+    return load_render_profile(profile).roles
+
+
+def set_profile_role(
+    profile: str | Path | RenderProfile,
+    role: str,
+    *,
+    engine: str,
+    target_id: str,
+    language: str,
+    voice: str | None = None,
+    speaker: str | int | None = None,
+    voice_source: Mapping[str, Any] | None = None,
+    options: Mapping[str, Any] | None = None,
+    offline: bool = False,
+    refresh: bool = False,
+    make_default: bool = False,
+) -> RenderProfile:
+    """Add or replace a role using freshly resolved engine-derived facts."""
+    _validate_role_name(role)
+    original = load_render_profile(profile)
+    proposed = create_render_profile(
+        engine=engine,
+        target_id=target_id,
+        language=language,
+        role=role,
+        voice=voice,
+        speaker=speaker,
+        voice_source=voice_source,
+        options=options,
+        offline=offline,
+        refresh=refresh,
+    )
+    roles = dict(original.roles)
+    roles[role] = proposed.roles[role]
+    default_role = role if make_default else original.default_role
+    return replace(
+        original,
+        roles=roles,
+        default_role=default_role,
+        profile_id=None,
+    ).with_identity()
+
+
+def remove_profile_role(
+    profile: str | Path | RenderProfile,
+    role: str,
+    *,
+    new_default_role: str | None = None,
+) -> RenderProfile:
+    """Remove a role, requiring an explicit replacement for the current default."""
+    _validate_role_name(role)
+    original = load_render_profile(profile)
+    if role not in original.roles:
+        raise ProfileError(f"RenderProfile has no role {role!r}")
+    if len(original.roles) == 1:
+        raise ProfileError("Cannot remove the final RenderProfile role")
+    if role == original.default_role and new_default_role is None:
+        raise ProfileError("Removing the default role requires --new-default-role")
+
+    roles = dict(original.roles)
+    del roles[role]
+    default_role = original.default_role
+    if new_default_role is not None:
+        _validate_role_name(new_default_role)
+        if new_default_role not in roles:
+            raise ProfileError(
+                f"New default role {new_default_role!r} is not present after removal"
+            )
+        default_role = new_default_role
+    return replace(
+        original,
+        roles=roles,
+        default_role=default_role,
+        profile_id=None,
+    ).with_identity()
+
+
+def set_default_profile_role(
+    profile: str | Path | RenderProfile,
+    role: str,
+) -> RenderProfile:
+    """Set the default role and recompute the profile's content identity."""
+    _validate_role_name(role)
+    original = load_render_profile(profile)
+    if role not in original.roles:
+        raise ProfileError(f"RenderProfile has no role {role!r}")
+    if role == original.default_role:
+        return original
+    return replace(original, default_role=role, profile_id=None).with_identity()
+
+
+def _validate_role_name(role: str) -> None:
+    if not isinstance(role, str) or not role.strip():
+        raise ProfileError("Profile role name must not be empty")
+
+
+__all__ = [
+    "list_profile_roles",
+    "remove_profile_role",
+    "set_default_profile_role",
+    "set_profile_role",
+]
