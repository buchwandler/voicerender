+class _BookProgress:
+    def __init__(
+        self,
+        chapters: Sequence[_LoadedChapter],
+        total_count: int,
+    ) -> None:
+        self.total_count = total_count
+        self.tracker = ProgressTracker(total_count)
+        self._engine_by_item: dict[tuple[str, int, str], str] = {}
+        self._remaining_by_engine: Counter[str] = Counter()
