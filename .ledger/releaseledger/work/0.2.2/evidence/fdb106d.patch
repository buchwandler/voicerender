++    _validate_recipe(recipe)
++    target = _output_path(
++        output, suffix=".wav", force=force, label="VoiceDesign output"
++    )
++    sidecar = (
++        _output_path(
++            source_output, suffix=".toml", force=force, label="Voice source sidecar"
++        )
++        if source_output is not None
++        else None
