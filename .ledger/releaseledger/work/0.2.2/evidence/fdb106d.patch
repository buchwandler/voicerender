++                EngineDiagnostic(
++                    code=getattr(exc, "code", "qwen3.reference_invalid"),
++                    severity="error",
++                    message=str(exc),
++                    field="render.target.voice",
++                    details=getattr(exc, "details", {}),
++                ),
++            )
