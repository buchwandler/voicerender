+    monkeypatch, capsys
+) -> None:
+    monkeypatch.setattr(cli, "list_models", lambda *args, **kwargs: (_sopro_model(),))
+
+    exit_code = cli.main(["models", "list", "--engine", "sopro", "--json"])
