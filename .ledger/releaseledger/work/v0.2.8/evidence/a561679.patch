+        cli.main(
+            [
+                "lexicons",
+                "list",
+                "--engine",
+                "kokoro",
+                "--lang",
+                "en-US",
+                "--target",
+                "v1.0",
+                "--json",
+            ]
+        )
+        == 0
+    )
+    rows = json.loads(capsys.readouterr().out)
+    assert rows == [_entry().to_dict()]
+    assert adapter.discovery_args == {
+        "language": "en-US",
+        "model": "v1.0",
+        "offline": False,
+        "refresh": False,
+        "preference": "auto",
+    }
+
+    assert (
+        cli.main(["lexicons", "inspect", "lexhint", "--lang", "en-US", "--json"]) == 0
+    )
+    assert json.loads(capsys.readouterr().out) == _entry().to_dict()
+
