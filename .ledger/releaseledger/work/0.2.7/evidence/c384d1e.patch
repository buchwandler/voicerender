+
+
+def test_check_readiness_does_not_require_render_completion(tmp_path: Path) -> None:
+    root = _write_bundle(tmp_path)
+    variant_name, _ = _write_variant(root, "ready-voice")
+    result = inspect_bundle(root, variant=variant_name)
