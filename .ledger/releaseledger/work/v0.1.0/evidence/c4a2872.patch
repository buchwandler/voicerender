+def test_sample_rate_mismatch_between_children_is_a_typed_backend_error():
+    request = _request("alpha beta")
+    session = _MeasuredSession(6)
+    calls: list[SpeechRequest] = []
+
+    def synthesize(request: SpeechRequest) -> RenderedSpeech:
