+name: Run tests
+
+on:
+  push:
+  pull_request:
+  workflow_call:
+
+jobs:
+  test:
+    runs-on: ${{ matrix.os }}
+    strategy:
+      matrix:
+        os: [ubuntu-latest, windows-latest, macos-latest]
+        python-version: ["3.10", "3.11", "3.12", "3.13", "3.14"]
+    steps:
+      - uses: actions/checkout@v4
+      - name: Set up Python
+        uses: actions/setup-python@v5
+        with:
+          python-version: ${{ matrix.python-version }}
+      - name: Install package
+        run: |
+          python -m pip install --upgrade pip
+          python -m pip install -e ".[dev]"
+          python -m compileall -q voicerender tests
+      - name: Run tests
+        run: python -m pytest -q
+
+  lower-bounds:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - name: Set up Python
+        uses: actions/setup-python@v5
+        with:
+          python-version: "3.10"
+      - name: Install lower-bound dependencies
+        run: |
+          python -m pip install --upgrade pip
+          python -m pip install \
+            "pytest==8.0.0" \
+            "numpy==1.23.0" \
+            "soundfile==0.12.1" \
+            "tomli==2.0.1"
+          python -m pip install --no-deps -e .
+      - name: Run lower-bound tests
+        run: python -m pytest -q
+
+  package-smoke:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - name: Set up Python
+        uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+      - name: Build wheel and sdist
+        run: |
+          python -m pip install --upgrade pip build
+          python -m build --outdir "$RUNNER_TEMP/dist"
+      - name: Verify package contents
+        run: |
+          python - <<'PY'
+          import os
+          import tarfile
+          from email import policy
+          from email.parser import Parser
+          from pathlib import Path
+          from zipfile import ZipFile
+
+          from packaging.requirements import Requirement
+
+          artifacts = Path(os.environ["RUNNER_TEMP"]) / "dist"
+          wheel = next(artifacts.glob("voicerender-*.whl"))
+          sdist = next(artifacts.glob("voicerender-*.tar.gz"))
+          expected = {
+              "voicerender/py.typed",
+              "voicerender/schemas/render-manifest-v2.schema.json",
+          }
+
+          with ZipFile(wheel) as archive:
+              names = set(archive.namelist())
+              assert expected <= names
+              metadata_name = next(name for name in names if name.endswith("METADATA"))
+              metadata = Parser(policy=policy.default).parsestr(
+                  archive.read(metadata_name).decode("utf-8")
+              )
+              requirements = {
+                  Requirement(value).name
+                  for value in metadata.get_all("Requires-Dist", [])
+              }
+              assert {"numpy", "soundfile"} <= requirements
+
+          with tarfile.open(sdist, "r:gz") as archive:
+              names = archive.getnames()
+              assert all(any(name.endswith(resource) for name in names) for resource in expected)
+          PY
+      - name: Install wheel in clean environment
+        run: |
+          python -m venv "$RUNNER_TEMP/voicerender-wheel-venv"
+          "$RUNNER_TEMP/voicerender-wheel-venv/bin/python" -m pip install \
+            "$RUNNER_TEMP"/dist/voicerender-*.whl
+      - name: Run installed smoke checks
+        run: |
+          VENV="$RUNNER_TEMP/voicerender-wheel-venv"
+          "$VENV/bin/python" -c \
+            "import importlib.metadata as m; import voicerender; assert m.version('voicerender') == voicerender.__version__"
+          "$VENV/bin/voicerender" --version
+          "$VENV/bin/voicerender" engines list --json
+          "$VENV/bin/voicerender" profiles validate examples/voices/voice.toml
+
+  docs:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - name: Set up Python
+        uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+      - name: Install documentation dependencies
+        run: |
+          python -m pip install --upgrade pip
+          python -m pip install -r docs/requirements.txt
+      - name: Build documentation
+        run: sphinx-build -W --keep-going -D master_doc=utterplan-v5-integration -b html docs docs/_build/html
