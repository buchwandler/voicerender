+"""Mocked released-package public contracts: no models or network required."""
+
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+
+import numpy as np
+
+from voicerender.engines.piper import PiperAdapter, discover_voices as piper_voices
+from voicerender.engines.pocket import PocketAdapter, discover_voices as pocket_voices
+from voicerender.models import VoiceBinding
+
+
+def test_piper_public_api(monkeypatch):
+    events = []
+
+    class FakePiperVoice:
+        @classmethod
+        def from_pretrained(cls, *args, **kwargs):
+            events.append(("load", args, kwargs))
+            return cls()
+
+        def synthesize(self, request, *, config):
+            events.append(
+                ("synthesize", request.text, request.speaker, config.length_scale)
+            )
+            return SimpleNamespace(
+                audio=np.ones(80, dtype=np.float32) / 4, sample_rate=16000, warnings=()
+            )
+
+        def close(self):
+            events.append(("close",))
+
+    class SynthesisConfig:
+        def __init__(self, **kwargs):
+            self.length_scale = kwargs["length_scale"]
+
+    class VoiceAssetManager:
+        def __init__(self, offline):
+            pass
+
+        def list_voices(self, language):
+            return [SimpleNamespace(id="model", name="Model", language_code="en-US")]
+
+    fake = SimpleNamespace(
+        PiperVoice=FakePiperVoice,
+        SynthesisConfig=SynthesisConfig,
+        SynthesisRequest=lambda **kwargs: SimpleNamespace(**kwargs),
+        VoiceLevelConfig=lambda mode: SimpleNamespace(mode=mode),
+        VoiceAssetManager=VoiceAssetManager,
+    )
+    monkeypatch.setitem(sys.modules, "pipersynth", fake)
+    adapter = PiperAdapter()
+    binding = VoiceBinding(
+        engine="piper", target_id="model", speaker=1, options={"native_speed": 2.0}
+    )
+    with adapter.open(binding) as session:
+        result = session.synthesize(request_id="1", text="hello", language="en-US")
+        assert result.sample_rate == 16000
+    assert events[1] == ("synthesize", "hello", 1, 0.5)
+    assert events[2] == ("close",)
+    assert piper_voices(language="en-US")[0]["target_id"] == "model"
+
+
+def test_pocket_reference_audio_public_api(monkeypatch, tmp_path):
+    events = []
+
+    class Runtime:
+        @classmethod
+        def from_resolved(cls, bundle, offline):
+            events.append(("runtime", bundle))
+            return cls()
+
+        def prepare_voice(self, voice_source):
+            events.append(("prepare", str(voice_source)))
+            return "prepared"
+
+        def synthesize(self, request, *, voice, config, voice_level):
+            events.append(("synthesize", request.text, voice))
+            return SimpleNamespace(
+                audio=np.ones(40, dtype=np.float32) / 4, sample_rate=24000, warnings=()
+            )
+
+        def close(self):
+            events.append(("close",))
+
+    class BundleManager:
+        def __init__(self, offline):
+            events.append(("bundle_manager", offline))
+
+        def resolve_bundle(self, name, precision):
+            return name
+
+        def list_bundles(self, language):
+            return [SimpleNamespace(id="english", predefined_voices=("alba", "alex"))]
+
+    fake = SimpleNamespace(
+        PocketRuntime=Runtime,
+        BundleAssetManager=BundleManager,
+        SynthesisRequest=lambda **kwargs: SimpleNamespace(**kwargs),
+        GenerationConfig=lambda **kwargs: kwargs,
+        VoiceLevelConfig=lambda mode: SimpleNamespace(mode=mode),
+    )
+    monkeypatch.setitem(sys.modules, "pocketsynth", fake)
+    ref = tmp_path / "reference.wav"
+    ref.write_bytes(b"fixture")
+    binding = VoiceBinding(engine="pocket", target_id="english", reference_audio=ref)
+    with PocketAdapter().open(binding) as session:
+        result = session.synthesize(request_id="1", text="cloned", language="en-US")
+        assert result.sample_rate == 24000
+    assert ("prepare", str(ref)) in events
+    assert ("synthesize", "cloned", "prepared") in events
+    assert events[-1] == ("close",)
+    assert pocket_voices()[0]["voices"] == ["alba", "alex"]
+
+
+def test_cli_render_with_fake_piper_runtime(monkeypatch, tmp_path):
+    from voicerender.cli import main
+    from voicerender.storage import wav_info
+    from types import SimpleNamespace
+
+    class Voice:
+        @classmethod
+        def from_pretrained(cls, *args, **kwargs):
+            return cls()
+
+        def synthesize(self, request, *, config):
+            return SimpleNamespace(
+                audio=np.full(96, 0.1, dtype=np.float32), sample_rate=16000, warnings=()
+            )
+
+        def close(self):
+            return None
+
+    fake = SimpleNamespace(
+        PiperVoice=Voice,
+        SynthesisConfig=lambda **kwargs: kwargs,
+        SynthesisRequest=lambda **kwargs: SimpleNamespace(**kwargs),
+        VoiceLevelConfig=lambda mode: mode,
+    )
+    monkeypatch.setitem(sys.modules, "pipersynth", fake)
+    plan = tmp_path / "plan.toml"
+    plan.write_text(
+        'schema = "utterplan.voiceplan.v1"\n[[segments]]\nid = "s1"\ntext = "Hello"\n'
+    )
+    profile = tmp_path / "profile.toml"
+    profile.write_text(
+        'schema = "voicerender.voice-profile.v1"\nname = "simple"\n[roles.narrator]\nengine = "piper"\ntarget_id = "en_US-amy-medium"\n'
+    )
+    out = tmp_path / "renders"
+    args = [
+        "render",
+        str(plan),
+        "--profile",
+        str(profile),
+        "--out-dir",
+        str(out),
+        "--take",
+        "1",
+        "--json",
+    ]
+    assert main(args) == 0
+    manifest = __import__("json").loads((out / "manifest.json").read_text())
+    assert manifest["complete"]
+    assert wav_info(out / manifest["segments"][0]["path"])["frames"] == 96
+    assert main(args) == 0
+    assert main(["inspect", str(out / "manifest.json")]) == 0
diff --git a/tests/test_renderer.py b/tests/test_renderer.py
new file mode 100644
index 0000000..859e751
--- /dev/null
+++ b/tests/test_renderer.py
@@ -0,0 +1,264 @@
+from __future__ import annotations
+
+import json
+import sys
+from contextlib import contextmanager
+from pathlib import Path
+
+import numpy as np
+import pytest
+import soundfile as sf
+
+from voicerender import (
+    PlanError,
+    ProfileError,
+    SpeechSegment,
+    VoiceBinding,
+    VoicePlan,
+    VoiceProfile,
+    render,
+    render_plan,
+)
+from voicerender.cli import main
+from voicerender.engines import get_engine, list_engines, register_engine
+from voicerender.engines.base import EngineCapabilities, SynthesisOutput
+from voicerender.engines import _ADAPTERS
+
+
+class FakeEngine:
+    id = "testengine"
+    package = "fake-backend"
+    capabilities = EngineCapabilities(supports_reference_audio=True)
+
+    def __init__(self):
+        self.calls = []
+        self.fail_once_for = None
+
+    def version(self):
+        return "1.0"
+
+    def validate(self, binding):
+        if binding.target_id == "bad":
+            raise ProfileError("target not available")
+
+    @contextmanager
+    def open(self, binding):
+        owner = self
+
+        class Session:
+            def synthesize(self, *, request_id, text, language):
+                owner.calls.append((request_id, text, language, binding.target_id))
+                if request_id == owner.fail_once_for:
+                    owner.fail_once_for = None
+                    raise RuntimeError("injected interruption")
+                return SynthesisOutput(
+                    audio=np.full(160, 0.1, dtype=np.float32), sample_rate=16000
+                )
+
+        yield Session()
+
+
+@pytest.fixture
+def mock_engine(monkeypatch):
+    adapter = FakeEngine()
+    monkeypatch.setitem(_ADAPTERS, adapter.id, adapter)
+    return adapter
+
+
+def segments():
+    return [
+        SpeechSegment(id="s1", scope_id="chapter", role="narrator", text="First."),
+        SpeechSegment(id="s2", scope_id="chapter", role="guest", text="Second."),
+        SpeechSegment(id="s3", scope_id="chapter", role="narrator", text="Third."),
+    ]
+
+
+def profile(*, narrator="narrator-model", guest="guest-model", name="cast"):
+    return VoiceProfile(
+        name=name,
+        roles={
+            "narrator": VoiceBinding(engine="testengine", target_id=narrator),
+            "guest": VoiceBinding(engine="testengine", target_id=guest),
+        },
+    )
+
+
+def read_manifest(directory):
+    return json.loads((directory / "manifest.json").read_text())
+
+
+def test_render_reuse_and_cross_profile_cache(tmp_path, mock_engine):
+    out = tmp_path / "voice1"
+    result = render(segments(), profile=profile(), output_dir=out, take=2)
+    assert (result.rendered_count, result.reused_count, result.selected_count) == (
+        2,
+        0,
+        2,
+    )
+    manifest = read_manifest(out)
+    assert manifest["complete"] and len(manifest["segments"]) == 2
+    assert manifest["source_plan_id"] is None
+    for item in manifest["segments"]:
+        assert item["wav"]["frames"] == 160
+        assert item["wav"]["sample_rate"] == 16000
+        with sf.SoundFile(out / item["path"]) as file:
+            assert file.frames == 160
+    second = render(segments(), profile=profile(), output_dir=out, take=2)
+    assert (second.rendered_count, second.reused_count) == (0, 2)
+    other = render(
+        segments(),
+        profile=profile(name="different-label"),
+        output_dir=tmp_path / "voice2",
+        take=2,
+    )
+    assert (other.rendered_count, other.reused_count) == (0, 2)
+    assert len(mock_engine.calls) == 2
+
+
+def test_only_changed_role_rerenders(tmp_path, mock_engine):
+    out = tmp_path / "voice1"
+    render(segments(), profile=profile(), output_dir=out)
+    changed = render(
+        segments(), profile=profile(guest="different-guest"), output_dir=out
+    )
+    assert (changed.rendered_count, changed.reused_count) == (1, 2)
+    assert len(mock_engine.calls) == 4
+
+
+def test_interruption_is_resumable(tmp_path, mock_engine):
+    out = tmp_path / "render"
+    mock_engine.fail_once_for = "s2"
+    with pytest.raises(RuntimeError, match="injected interruption"):
+        render(segments(), profile=profile(), output_dir=out)
+    interrupted = read_manifest(out)
+    assert [item["status"] for item in interrupted["segments"]] == [
+        "rendered",
+        "failed",
+        "pending",
+    ]
+    assert not interrupted["complete"]
+    resumed = render(segments(), profile=profile(), output_dir=out)
+    assert (resumed.rendered_count, resumed.reused_count) == (2, 1)
+    assert read_manifest(out)["complete"]
+    assert len(mock_engine.calls) == 4
+    assert not (out / ".voicerender.lock").exists()
+
+
+def test_corrupt_cache_is_not_reused(tmp_path, mock_engine):
+    a = tmp_path / "a"
+    first = render(segments(), profile=profile(), output_dir=a, take=1)
+    cache = tmp_path / ".voicerender-cache"
+    key = read_manifest(a)["segments"][0]["synthesis_key"]
+    (cache / f"{key}.wav").write_bytes(b"bad")
+    second = render(segments(), profile=profile(), output_dir=tmp_path / "b", take=1)
+    assert second.rendered_count == 1 and second.reused_count == 0
+
+
+def test_force_disables_cache(tmp_path, mock_engine):
+    out = tmp_path / "o"
+    render(segments(), profile=profile(), output_dir=out, take=1)
+    result = render(segments(), profile=profile(), output_dir=out, take=1, force=True)
+    assert result.rendered_count == 1 and result.reused_count == 0
+
+
+def test_reference_audio_affects_key_not_path(tmp_path, mock_engine):
+    reference1 = tmp_path / "ref1.wav"
+    reference2 = tmp_path / "ref2.wav"
+    reference1.write_bytes(b"speaker A")
+    reference2.write_bytes(b"speaker A")
+
+    def make(reference):
+        return VoiceProfile(
+            name="clone",
+            roles={
+                "narrator": VoiceBinding(
+                    engine="testengine",
+                    target_id="clone-model",
+                    reference_audio=reference,
+                )
+            },
+        )
+
+    speech = [segments()[0]]
+    first = render(speech, profile=make(reference1), output_dir=tmp_path / "a")
+    second = render(speech, profile=make(reference2), output_dir=tmp_path / "b")
+    assert first.rendered_count == 1 and second.reused_count == 1
+    reference2.write_bytes(b"speaker B")
+    third = render(speech, profile=make(reference2), output_dir=tmp_path / "c")
+    assert third.rendered_count == 1
+    assert len(mock_engine.calls) == 2
+
+
+def test_selection_validation(tmp_path, mock_engine):
+    with pytest.raises(PlanError, match="Use take or select"):
+        render(
+            segments(),
+            profile=profile(),
+            output_dir=tmp_path / "x",
