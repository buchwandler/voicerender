+def _install(
+    monkeypatch: pytest.MonkeyPatch,
+) -> tuple[Any, ModuleType, dict[str, Any]]:
+    from voicerender.engines.chatterboxsynth import ChatterboxSynthEngineAdapter
+
+    module, state = _fake_chatterboxsynth()
